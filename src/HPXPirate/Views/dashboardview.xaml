<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HPXPirate.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctrl="clr-namespace:HPXPirate.Controls" FontFamily="{StaticResource Font.Primary}" xmlns:views="clr-namespace:HPXPirate.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="MetricCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Setter Property="Border.Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="158" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
    <StackPanel>
      <TextBlock Text="Dashboard" Style="{StaticResource H1}" />
      <TextBlock Text="Live system and game performance overview. Everything is measured, nothing is faked." Style="{StaticResource Caption}" Margin="0,2,0,18" />
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
          <StackPanel>
            <TextBlock Text="HPX PERFORMANCE ENGINE" Style="{StaticResource MetricLabel}" />
            <Button Style="{StaticResource BoostButton}" Content="BOOST NOW" Margin="0,14,0,0" HorizontalAlignment="Left" Command="{Binding BoostCommand}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" Text="{Binding BoostSummary}" />
            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding BoostSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="18" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{Binding Success, Converter={StaticResource StatusToBrush}}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                      <TextBlock Style="{StaticResource Caption}" Text="{Binding Detail}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusHealthy, Converter={StaticResource StatusToBrush}}" />
              <TextBlock Style="{StaticResource H2}" Margin="10,0,0,0" Text="{Binding StatusTitle}" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{Binding StatusDetail}" />
            <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Visibility="{Binding StatusRecommendation, Converter={StaticResource NullToVis}}">
              <StackPanel>
                <TextBlock Text="RECOMMENDATION" Style="{StaticResource MetricLabel}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding StatusRecommendation}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,28,0">
            <TextBlock Text="FPS" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" Foreground="{StaticResource Brush.Accent.Magenta}" Text="{Binding FpsDisplay}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding FrameTimeDisplay}" />
          </StackPanel>
          <ctrl:LineGraph Grid.Column="1" Height="120" Stroke="{StaticResource Brush.Accent.Magenta}" Values="{Binding FpsSeries}" />
        </Grid>
      </Border>
      <WrapPanel Margin="0,14,0,0">
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="AVG FPS" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding AverageFps, StringFormat={}{0:0}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="1% LOW" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding OnePercentLow, StringFormat={}{0:0}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="0.1% LOW" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding PointOnePercentLow, StringFormat={}{0:0}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="FRAME TIME" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding FrameTime, StringFormat={}{0:0.0} ms}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="CPU LOAD" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding Cpu, StringFormat={}{0:0} %}" Foreground="{Binding Cpu, Converter={StaticResource PercentToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding CpuTemp, StringFormat=Temp {0:0}u00B0C}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="GPU LOAD" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding Gpu, StringFormat={}{0:0} %}" Foreground="{Binding Gpu, Converter={StaticResource PercentToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding GpuTemp, StringFormat=Temp {0:0}u00B0C}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="MEMORY" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding RamPercent, StringFormat={}{0:0} %}" Foreground="{Binding RamPercent, Converter={StaticResource PercentToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" Text="{Binding RamText}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource MetricCard}">
          <StackPanel>
            <TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" />
            <TextBlock Style="{StaticResource MetricBig}" FontSize="26" Text="{Binding VramPercent, StringFormat={}{0:0} %}" Foreground="{Binding VramPercent, Converter={StaticResource PercentToBrush}}" />
            <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Text="{Binding GpuName}" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <Grid Margin="0,2,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="FRAME TIME (ms)" Style="{StaticResource MetricLabel}" />
            <ctrl:LineGraph Height="120" Margin="0,10,0,0" Stroke="{StaticResource Brush.Accent.Cyan}" Values="{Binding FrameTimeSeries}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="CPU / GPU LOAD (%)" Style="{StaticResource MetricLabel}" />
            <Grid Margin="0,10,0,0" Height="120">
              <ctrl:LineGraph Stroke="{StaticResource Brush.Ok}" AutoScale="False" MaxValue="100" Values="{Binding CpuSeries}" />
              <ctrl:LineGraph Stroke="{StaticResource Brush.Accent.Violet}" AutoScale="False" MaxValue="100" Values="{Binding GpuSeries}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>