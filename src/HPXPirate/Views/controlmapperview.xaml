<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HPXPirate.Views.ControlMapperView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource Font.Primary}" xmlns:views="clr-namespace:HPXPirate.Views;assembly=HPXPirate">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Control Mapper" Style="{StaticResource H1}" />
      <TextBlock Text="Map keyboard and mouse inputs to on-screen control points. Capture keys live, then drag points to position them." Style="{StaticResource Caption}" Margin="0,2,0,16" />
    </StackPanel>
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="PROFILE" Style="{StaticResource MetricLabel}" />
          <ComboBox Grid.Row="1" Margin="0,6,0,12" Style="{StaticResource HpxCombo}" DisplayMemberPath="Game" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />
          <ListBox Grid.Row="2" Background="#00FFFFFF" BorderThickness="0" Foreground="{StaticResource Brush.Text.Primary}" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                      <Border Name="bd" CornerRadius="8" Background="#00FFFFFF" Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Border.Background" Value="#14FFFFFF" />
                        </Trigger>
                        <Trigger Property="ListBoxItem.IsSelected" Value="True">
                          <Setter TargetName="bd" Property="Border.Background" Value="#22FF2BD6" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" CornerRadius="6" Background="#1AFF2BD6" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource Font.Mono}" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Magenta}" Text="{Binding Input}" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Action}" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding InputType}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
          <WrapPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Style="{StaticResource GhostButton}" Content="+ Key" Margin="0,0,6,6" Command="{Binding AddKeyCommand}" />
            <Button Style="{StaticResource GhostButton}" Content="+ Mouse" Margin="0,0,6,6" Command="{Binding AddMouseCommand}" />
            <Button Style="{StaticResource GhostButton}" Content="Remove" Margin="0,0,6,6" Command="{Binding RemoveCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,6,6" Command="{Binding SaveCommand}" />
          </WrapPanel>
        </Grid>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Style="{StaticResource PrimaryButton}" Content="CAPTURE INPUT" Command="{Binding CaptureCommand}" />
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Status}" />
          </StackPanel>
          <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0" ClipToBounds="True">
            <Grid>
              <Image Source="pack://application:,,,/Assets/hpx_logo.png" Stretch="Uniform" Opacity="0.06" />
              <Canvas Name="MapCanvas" Background="#00FFFFFF" ClipToBounds="True" />
            </Grid>
          </Border>
          <TextBlock Grid.Row="2" Text="Drag any control point to reposition it. Coordinates are stored per profile." Style="{StaticResource Caption}" Margin="0,10,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>