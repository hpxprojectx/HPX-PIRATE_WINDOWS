<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HPXPirate.Views.KeyboardTuningView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource Font.Primary}" xmlns:views="clr-namespace:HPXPirate.Views;assembly=HPXPirate">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
    <StackPanel>
      <TextBlock Text="Keyboard Tuning" Style="{StaticResource H1}" />
      <TextBlock Text="Real Windows keyboard tuning. Values are read from the OS first, so settings that are already correct are reported as &quot;Already optimal&quot; and never changed." Style="{StaticResource Caption}" Margin="0,2,0,18" TextWrapping="Wrap" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="GAMING KEYBOARD PROFILE" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable keyboard tuning" IsChecked="{Binding Enabled}" />
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="KEY REPEAT DELAY (0-3)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding RepeatDelay, StringFormat={}{0} / 3}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="3" Value="{Binding RepeatDelay}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="KEY REPEAT RATE (0-31)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding RepeatRate, StringFormat={}{0} / 31}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="31" Value="{Binding RepeatRate}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="ACCESSIBILITY KEYS (ONLY EVER TURNED OFF)" Style="{StaticResource MetricLabel}" Margin="0,18,0,6" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Disable Sticky Keys" Margin="0,0,0,12" IsChecked="{Binding DisableStickyKeys}" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Disable Filter Keys" Margin="0,0,0,12" IsChecked="{Binding DisableFilterKeys}" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Disable Toggle Keys" IsChecked="{Binding DisableToggleKeys}" />
            <TextBlock Text="These features can fire accidental key toggles mid-game. HPX PIRATE only turns them off when you ask, and never switches them on." Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="APPLY PROFILE" Command="{Binding ApplyCommand}" />
              <Button Style="{StaticResource GhostButton}" Content="Refresh live state" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
              <Button Style="{StaticResource GhostButton}" Content="Revert" Margin="10,0,0,0" Command="{Binding RevertCommand}" />
              <Button Style="{StaticResource DangerButton}" Content="RESTORE WINDOWS DEFAULTS" Margin="10,0,0,0" Command="{Binding RestoreDefaultsCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="LIVE WINDOWS STATE" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="Read directly from the OS. Reading never changes anything." Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BaseText}" Text="Key repeat delay" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.RepeatDelayText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BaseText}" Text="Key repeat rate" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.RepeatRateText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BaseText}" Text="Sticky Keys" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.StickyKeysText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BaseText}" Text="Filter Keys" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.FilterKeysText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BaseText}" Text="Toggle Keys" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.ToggleKeysText}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="WHAT CHANGED" Style="{StaticResource MetricLabel}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding Summary}" />
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource BaseText}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Status}" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
