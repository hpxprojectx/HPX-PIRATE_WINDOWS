<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HPXPirate.Views.FpsBoostView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource Font.Primary}" xmlns:views="clr-namespace:HPXPirate.Views;assembly=HPXPirate">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
    <StackPanel>
      <TextBlock Text="Real-Time FPS Boost" Style="{StaticResource H1}" />
      <TextBlock Text="FPS is measured live from the GPU's Present events (ETW / DxgKrnl) - the real frames your GPU presents, never a fake counter. The boost applies only real, reversible Windows changes, and only where a change is actually needed." Style="{StaticResource Caption}" Margin="0,2,0,18" TextWrapping="Wrap" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="LIVE FPS (REAL-TIME)" Style="{StaticResource MetricLabel}" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <TextBlock Style="{StaticResource MetricBig}" Foreground="{StaticResource Brush.Accent.Cyan}" Text="{Binding LiveFpsText}" />
              <TextBlock Text="FPS" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="8,0,0,10" />
            </StackPanel>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="AVG FPS" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding LiveAverageFpsText}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="FRAME TIME" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding LiveFrameTimeText}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="1% LOW" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding LiveOnePercentLowText}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding MonitorStatusText}" />
            <TextBlock Text="TARGET FPS" Style="{StaticResource MetricLabel}" Margin="0,18,0,6" />
            <TextBlock Style="{StaticResource Mono}" Text="{Binding TargetFps, StringFormat={}{0} FPS}" />
            <Slider Style="{StaticResource HpxSlider}" Minimum="60" Maximum="360" Value="{Binding TargetFps}" />
            <TextBlock Text="MEASUREMENT WINDOW (seconds)" Style="{StaticResource MetricLabel}" Margin="0,14,0,6" />
            <TextBlock Style="{StaticResource Mono}" Text="{Binding MeasureSeconds, StringFormat={}{0} s}" />
            <Slider Style="{StaticResource HpxSlider}" Minimum="1" Maximum="10" Value="{Binding MeasureSeconds}" />
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button Style="{StaticResource BoostButton}" Content="BOOST NOW" Command="{Binding BoostCommand}" />
              <Button Style="{StaticResource GhostButton}" Content="Reset FPS history" Margin="10,0,0,0" Command="{Binding ResetHistoryCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="BEFORE / AFTER (REAL MEASUREMENT)" Style="{StaticResource MetricLabel}" />
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="BEFORE" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource MetricBig}" FontSize="34" Text="{Binding FpsBeforeText}" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="AFTER" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource MetricBig}" FontSize="34" Foreground="{StaticResource Brush.Accent.Cyan}" Text="{Binding FpsAfterText}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="CHANGE" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource MetricBig}" FontSize="34" Foreground="{StaticResource Brush.Ok}" Text="{Binding DeltaText}" />
              </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" TextWrapping="Wrap" Text="{Binding Note}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Summary}" />
            <Button Style="{StaticResource DangerButton}" Content="REVERT FPS BOOST" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding RevertCommand}" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="BOOST STEPS" Style="{StaticResource MetricLabel}" />
          <TextBlock Text="Every step is detected first. Anything already correct is left untouched and shown as &quot;Already optimal&quot;." Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource BaseText}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Status}" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
