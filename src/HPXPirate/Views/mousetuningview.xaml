<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="HPXPirate.Views.MouseTuningView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="{StaticResource Font.Primary}" xmlns:views="clr-namespace:HPXPirate.Views;assembly=HPXPirate">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,28">
    <StackPanel>
      <TextBlock Text="Mouse Tuning" Style="{StaticResource H1}" />
      <TextBlock Text="Real Windows mouse tuning. Every value is read from the OS first, so settings that are already correct are reported as &quot;Already optimal&quot; and never changed." Style="{StaticResource Caption}" Margin="0,2,0,18" TextWrapping="Wrap" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
          <StackPanel>
            <TextBlock Text="GAMING MOUSE PROFILE" Style="{StaticResource H2}" Margin="0,0,0,12" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Enable mouse tuning" IsChecked="{Binding Enabled}" />
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Disable pointer acceleration (Enhance pointer precision)" Margin="0,12,0,0" IsChecked="{Binding DisableAcceleration}" />
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,14">
                <TextBlock Text="POINTER SPEED (1-20)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding PointerSpeed, StringFormat={}{0} / 20}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="1" Maximum="20" Value="{Binding PointerSpeed}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,14">
                <TextBlock Text="WHEEL SCROLL LINES" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding ScrollLines, StringFormat={}{0} line(s)}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="1" Maximum="10" Value="{Binding ScrollLines}" />
              </StackPanel>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="DOUBLE-CLICK SPEED (ms)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding DoubleClickSpeed, StringFormat={}{0} ms}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="200" Maximum="900" Value="{Binding DoubleClickSpeed}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="POINTER TRAILS (0 = off)" Style="{StaticResource MetricLabel}" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource Mono}" Text="{Binding PointerTrails, StringFormat={}{0}}" />
                <Slider Style="{StaticResource HpxSlider}" Minimum="0" Maximum="10" Value="{Binding PointerTrails}" />
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,18,0,0">
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Swap primary button" Margin="0,0,24,10" IsChecked="{Binding SwapButtons}" />
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Snap to default button" Margin="0,0,24,10" IsChecked="{Binding SnapToDefault}" />
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="ClickLock" Margin="0,0,24,10" IsChecked="{Binding ClickLock}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Style="{StaticResource PrimaryButton}" Content="APPLY PROFILE" Command="{Binding ApplyCommand}" />
              <Button Style="{StaticResource GhostButton}" Content="Refresh live state" Margin="10,0,0,0" Command="{Binding RefreshCommand}" />
              <Button Style="{StaticResource GhostButton}" Content="Revert" Margin="10,0,0,0" Command="{Binding RevertCommand}" />
              <Button Style="{StaticResource DangerButton}" Content="RESTORE WINDOWS DEFAULTS" Margin="10,0,0,0" Command="{Binding RestoreDefaultsCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="LIVE WINDOWS STATE" Style="{StaticResource MetricLabel}" />
            <TextBlock Text="Read directly from the OS. Reading never changes anything." Style="{StaticResource Caption}" Margin="0,2,0,12" TextWrapping="Wrap" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource BaseText}" Text="Pointer acceleration" Margin="0,0,0,8" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.AccelerationText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource BaseText}" Text="Pointer speed" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.PointerSpeedText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource BaseText}" Text="Wheel scroll" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.ScrollLinesText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource BaseText}" Text="Double-click speed" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.DoubleClickText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource BaseText}" Text="Primary button" Margin="0,0,0,8" />
              <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.ButtonsSwappedText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource BaseText}" Text="Snap to default" Margin="0,0,0,8" />
              <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.SnapText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource BaseText}" Text="ClickLock" Margin="0,0,0,8" />
              <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.ClickLockText}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource BaseText}" Text="Pointer trails" />
              <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Live.TrailsText}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="WHAT CHANGED" Style="{StaticResource MetricLabel}" />
          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" Text="{Binding Summary}" />
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Style="{StaticResource BaseText}" Text="{Binding Label}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource Mono}" Text="{Binding Status}" />
                  <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" Text="{Binding Status}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
